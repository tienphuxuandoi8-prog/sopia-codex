# ============================================================
# SOPHIA CODEX - BIẾN MÔI TRƯỜNG
# Sao chép file này thành .env và điền giá trị thật
# ============================================================

# App
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-64-char-random-string
CRON_SECRET=change-me-to-a-random-string

# Database (Supabase Postgres)
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Storage (ảnh bìa, avatar)
# Lấy từ: Supabase Dashboard → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
STORAGE_BUCKET=media

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM="Sophia Codex <onboarding@resend.dev>"

# AI (Google Gemini)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# VNPay (sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo (test)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api

# Seed Super Admin (chỉ dùng khi chạy db:seed lần đầu)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
